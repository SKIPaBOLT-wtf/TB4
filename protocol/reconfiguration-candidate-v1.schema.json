{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TB4 unreleased protected same-authority staged candidate v1; not activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "installation_id",
    "transition_id",
    "configuration_revision",
    "base_setup_revision",
    "base_setup_sha256",
    "seed_sha256",
    "authority",
    "bindings",
    "pin",
    "phase"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "RECONFIGURATION_CANDIDATE"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "base_setup_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "base_setup_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "binding"
          ],
          "properties": {
            "mode": {
              "const": "NATIVE_DOCS"
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_id",
                "tab_id",
                "domain_id"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "tab_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "domain_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "binding"
          ],
          "properties": {
            "mode": {
              "const": "FOLDER_SQLITE_V1"
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root_id",
                "domain_id"
              ],
              "properties": {
                "root_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "domain_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original",
        "profile",
        "archive",
        "transaction"
      ],
      "properties": {
        "original": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transaction": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "profile",
        "policy_digest",
        "runtime",
        "instructions",
        "files"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build_commit",
            "protocol",
            "capabilities"
          ],
          "properties": {
            "build_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "protocol": {
              "type": "integer",
              "minimum": 1
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "instructions": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 17,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "phase": {
      "enum": [
        "STAGING",
        "STAGED"
      ]
    }
  }
}
