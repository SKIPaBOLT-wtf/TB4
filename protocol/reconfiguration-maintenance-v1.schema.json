{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "installation_id",
    "authority",
    "transition_id",
    "configuration_revision",
    "phase",
    "adopted",
    "base_setup_sha256",
    "base_setup_revision",
    "pin",
    "baseline",
    "pending",
    "resolution"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "RECONFIGURATION_MAINTENANCE_WAL"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "authority": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "binding"
          ],
          "properties": {
            "mode": {
              "const": "NATIVE_DOCS"
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_id",
                "tab_id",
                "domain_id"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "tab_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "domain_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "binding"
          ],
          "properties": {
            "mode": {
              "const": "FOLDER_SQLITE_V1"
            },
            "binding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root_id",
                "domain_id"
              ],
              "properties": {
                "root_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "domain_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            }
          }
        }
      ]
    },
    "transition_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "phase": {
      "enum": [
        "ENTERING",
        "MAINTENANCE",
        "RESOLVED",
        "SUPERSEDED"
      ]
    },
    "adopted": {
      "type": "boolean"
    },
    "base_setup_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base_setup_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "profile",
        "policy_digest",
        "runtime",
        "instructions",
        "files"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build_commit",
            "protocol",
            "capabilities"
          ],
          "properties": {
            "build_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "protocol": {
              "type": "integer",
              "minimum": 1
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "instructions": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 17,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation_id",
        "transition_id",
        "payload_sha256"
      ],
      "properties": {
        "installation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "pending": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "epoch",
            "header",
            "protected",
            "before",
            "after"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "header": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            "protected": {
              "type": "string",
              "maxLength": 32768,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            "before": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            },
            "after": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9+/]*={0,2}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "resolution": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "evidence"
          ],
          "properties": {
            "decision": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transition_id",
                "revision",
                "owner",
                "epoch",
                "work_sha256",
                "setup_sha256"
              ],
              "properties": {
                "transition_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "work_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "setup_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "installation_id",
                "transition_id",
                "payload_sha256"
              ],
              "properties": {
                "installation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "transition_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TB4 unreleased protected maintenance WAL v1; not a dog state or grant",
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "ENTERING"
          }
        }
      },
      "then": {
        "properties": {
          "pending": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "epoch",
              "header",
              "protected",
              "before",
              "after"
            ],
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "epoch": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              },
              "header": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              },
              "protected": {
                "type": "string",
                "maxLength": 32768,
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              },
              "before": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              },
              "after": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^[A-Za-z0-9+/]*={0,2}$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "pending": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "RESOLVED"
          }
        }
      },
      "then": {
        "properties": {
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "evidence"
            ],
            "properties": {
              "decision": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "transition_id",
                  "revision",
                  "owner",
                  "epoch",
                  "work_sha256",
                  "setup_sha256"
                ],
                "properties": {
                  "transition_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "epoch": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  },
                  "work_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "setup_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "evidence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "installation_id",
                  "transition_id",
                  "payload_sha256"
                ],
                "properties": {
                  "installation_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "transition_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "payload_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "resolution": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "adopted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "pending": {
            "type": "null"
          }
        }
      }
    }
  ]
}
