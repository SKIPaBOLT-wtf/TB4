{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TB4 unreleased protected current-role exact partial Docs plan continuation; not activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "installation_id",
    "transition_id",
    "configuration_revision",
    "base_revision",
    "base_sha256",
    "authority",
    "target_root",
    "records_sha256",
    "objects",
    "index",
    "pending",
    "phase",
    "pin",
    "binding",
    "evidence",
    "evidence_binding",
    "plan",
    "adopted_index"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "const": "RECONFIGURATION_DOCS_ROOT_RESUME"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "transition_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "base_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "tab_id",
        "domain_id"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "tab_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "domain_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "target_root": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "records_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 129,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "id",
          "size",
          "before_seal",
          "after_seal"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(authority|artifact\\.[0-9]{3}\\.(input|output))$"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "size": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              }
            ]
          },
          "before_seal": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "after_seal": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 129
    },
    "pending": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "operation_id",
            "epoch",
            "dispatch"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "operation_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "dispatch": {
              "enum": [
                "PREPARED",
                "INVOKING",
                "REVOKED"
              ]
            }
          }
        }
      ]
    },
    "phase": {
      "enum": [
        "MOVING",
        "MOVED"
      ]
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "profile",
        "policy_digest",
        "runtime",
        "instructions",
        "files"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build_commit",
            "protocol",
            "capabilities"
          ],
          "properties": {
            "build_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "protocol": {
              "type": "integer",
              "minimum": 1
            },
            "capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "instructions": {
          "type": "string"
        },
        "files": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 17,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "binding": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation_id",
        "transition_id",
        "payload_sha256"
      ],
      "properties": {
        "installation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence_binding": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "adopted_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 129
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "transition_id",
        "source_root",
        "target_root",
        "blueprint_sha256",
        "references_sha256",
        "records_sha256"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "mode": {
          "const": "NATIVE_DOCS"
        },
        "transition_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_root": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "target_root": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "blueprint_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "references_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "records_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
